# ─── Núcleo ───
# Postgres (local, Supabase, Neon…). En Supabase usar el pooler de sesión o conexión directa.
DATABASE_URL=postgres://localhost:5432/llf_dev
# disable | require | no-verify
DATABASE_SSL=disable
# CA en PEM (opcional, "\n" escapados)
DATABASE_CA_CERT=
APP_URL=http://localhost:3000
# production | staging | development (distinto de NODE_ENV: staging también compila en modo production)
APP_ENV=development
# Secreto para cron/jobs (Vercel Cron manda Authorization: Bearer $CRON_SECRET). >= 32 caracteres.
CRON_SECRET=
# Solo fuera de Vercel: cantidad de proxies/balanceadores propios que agregan al X-Forwarded-For (1 = un nginx).
# 0 = app expuesta directo. En Vercel no se usa (x-vercel-forwarded-for). Sin definir en producción fuera de Vercel:
# no se confía en ninguna cabecera de IP. Ver src/server/auth/ip.ts.
TRUSTED_PROXY_HOPS=
# Token para /api/ready con detalle (opcional)
HEALTH_TOKEN=

# ─── Sitio público ───
# WhatsApp general de la inmobiliaria en E.164 (+549387...). Vacío: el sitio ofrece teléfono en lugar de WhatsApp.
# Las fichas usan el WhatsApp del asesor con perfil público cuando existe.
SITE_WHATSAPP_E164=

# ─── Storage (S3 compatible: Supabase Storage, R2, S3). Sin esto en dev se usa disco local ───
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET_PUBLIC=
STORAGE_BUCKET_PRIVATE=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# ─── Email (Resend) ───
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Lucio López Fleming <avisos@dominio>"
EMAIL_FROM=
# Opcional: dirección de respuesta
EMAIL_REPLY_TO=
# Destino de avisos internos (leads web, alertas)
EMAIL_INTERNAL_TO=

# ─── WhatsApp Business Cloud API (oficial de Meta) · ver docs/INTEGRATIONS_WHATSAPP_AI.md ───
# Token de usuario del sistema (Business Manager) con whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
# ID del número (no el número de teléfono)
WHATSAPP_PHONE_NUMBER_ID=
# Texto aleatorio propio que se pega en el panel de Meta al suscribir el webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta: valida la firma X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# Opcional: versión de Graph API (por defecto v26.0)
WHATSAPP_GRAPH_VERSION=
# Opcional: plantilla APROBADA para retomar contacto pasadas 24 h (nombre exacto) e idioma (por defecto es_AR)
WHATSAPP_REENGAGEMENT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=

# ─── Meta (Instagram / Facebook) ───
META_PAGE_ID=
# Token de Página de larga duración (pages_manage_posts, instagram_content_publish)
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# Versión de Graph API (por defecto v26.0)
META_GRAPH_VERSION=

# ─── IA (Claude) ───
ANTHROPIC_API_KEY=
# Modelo del asistente de WhatsApp (si se cambia, revisar precios en src/server/ai/pricing.ts)
AI_MODEL=claude-sonnet-5

# ─── Portales ───
# Argenprop y Zonaprop no tienen API pública (acuerdo comercial): sin variables hasta recibir su especificación.
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
# Solo arranque: el refresh token rota en cada uso y se guarda cifrado en la base
MERCADOLIBRE_REFRESH_TOKEN=
# silver | gold | gold_premium… (según el paquete contratado)
MERCADOLIBRE_LISTING_TYPE=silver
# Celular de WhatsApp E.164 (+549…), obligatorio en avisos de inmuebles desde 2026-10-01
MERCADOLIBRE_CONTACT_WHATSAPP=

# ─── Credenciales rotativas cifradas (AES-256-GCM) ───
# 32 bytes en base64: openssl rand -base64 32. Si cambia, hay que volver a autorizar Mercado Libre.
INTEGRATIONS_ENCRYPTION_KEY=

# ─── Observabilidad ───
SENTRY_DSN=

# Firma de subidas directas al storage (≥ 32 caracteres). Si falta se usa CRON_SECRET.
UPLOAD_SIGNING_SECRET=
