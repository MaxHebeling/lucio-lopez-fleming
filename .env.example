# ─── Núcleo ───
# Postgres (local, Supabase, Neon…). En Supabase usar el pooler de sesión o conexión directa.
DATABASE_URL=postgres://localhost:5432/llf_dev
# disable | require | no-verify
DATABASE_SSL=disable
# CA en PEM (opcional, "\n" escapados)
DATABASE_CA_CERT=
APP_URL=http://localhost:3000
# production | staging | development (distinto de NODE_ENV: staging también compila en modo production)
APP_ENV=development
# Secreto para cron/jobs (Vercel Cron manda Authorization: Bearer $CRON_SECRET). >= 32 caracteres.
CRON_SECRET=
# Token para /api/ready con detalle (opcional)
HEALTH_TOKEN=

# ─── Storage (S3 compatible: Supabase Storage, R2, S3). Sin esto en dev se usa disco local ───
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET_PUBLIC=
STORAGE_BUCKET_PRIVATE=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# ─── Email (Resend) ───
RESEND_API_KEY=
EMAIL_FROM=
# Destino de avisos internos (leads web, alertas)
EMAIL_INTERNAL_TO=

# ─── WhatsApp Business Cloud API (oficial de Meta) ───
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── Meta (Instagram / Facebook) ───
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# ─── IA (Claude) ───
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ─── Portales ───
ARGENPROP_API_KEY=
ZONAPROP_API_KEY=
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REFRESH_TOKEN=

# ─── Observabilidad ───
SENTRY_DSN=
